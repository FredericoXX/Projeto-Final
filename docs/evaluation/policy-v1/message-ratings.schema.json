{
  "$defs": {
    "BoundMessageRating": {
      "additionalProperties": false,
      "description": "Juízo humano sobre uma mensagem identificada da execução principal.",
      "properties": {
        "case_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "condition": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "rater_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rater Id",
          "type": "string"
        },
        "acceptable": {
          "title": "Acceptable",
          "type": "boolean"
        },
        "criteria": {
          "$ref": "#/$defs/BoundMessageRubric"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "run_number": {
          "minimum": 1,
          "title": "Run Number",
          "type": "integer"
        },
        "message_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Message Sha256",
          "type": "string"
        },
        "packet_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Packet Digest"
        },
        "outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "review_item_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Item Id"
        }
      },
      "required": [
        "case_id",
        "condition",
        "rater_id",
        "acceptable",
        "criteria",
        "run_number",
        "message_sha256",
        "packet_digest",
        "outcome_id"
      ],
      "title": "BoundMessageRating",
      "type": "object"
    },
    "BoundMessageRubric": {
      "additionalProperties": false,
      "description": "A rubrica M7 com booleanos estritos. ``None`` é não aplicável.",
      "properties": {
        "supported_and_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supported And Complete"
        },
        "gap_declared": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gap Declared"
        },
        "clarification_material_and_covered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clarification Material And Covered"
        },
        "outdated_notice_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outdated Notice Present"
        },
        "escalation_without_transmission": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Escalation Without Transmission"
        }
      },
      "required": [
        "supported_and_complete",
        "gap_declared",
        "clarification_material_and_covered",
        "outdated_notice_present",
        "escalation_without_transmission"
      ],
      "title": "BoundMessageRubric",
      "type": "object"
    },
    "RatingProvenance": {
      "additionalProperties": false,
      "description": "Quem julgou.\n\n- ``one_rater_per_message`` — cada mensagem tem o juízo de um só avaliador\n  (``raters``), e ``rater_id`` identifica-o;\n- ``human_consolidation`` — vários avaliadores (``raters``) julgaram em\n  separado e pessoas identificadas (``consolidated_by``) escreveram o juízo\n  consolidado; ``rater_id`` identifica quem o consolidou.",
      "properties": {
        "kind": {
          "enum": [
            "one_rater_per_message",
            "human_consolidation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "raters": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Raters",
          "type": "array"
        },
        "consolidated_by": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "title": "Consolidated By",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "raters"
      ],
      "title": "RatingProvenance",
      "type": "object"
    },
    "SourceReport": {
      "additionalProperties": false,
      "description": "A recolha a que os juízos pertencem.",
      "properties": {
        "collection_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Collection Id"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        }
      },
      "required": [
        "collection_id",
        "report_sha256"
      ],
      "title": "SourceReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "policy_v1_message_ratings_2",
      "title": "Schema Version",
      "type": "string"
    },
    "identity_version": {
      "const": "policy_v1_message_identity_1",
      "title": "Identity Version",
      "type": "string"
    },
    "set_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Set Id",
      "type": "string"
    },
    "source_report": {
      "$ref": "#/$defs/SourceReport"
    },
    "provenance": {
      "$ref": "#/$defs/RatingProvenance"
    },
    "ratings": {
      "items": {
        "$ref": "#/$defs/BoundMessageRating"
      },
      "title": "Ratings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "identity_version",
    "set_id",
    "source_report",
    "provenance",
    "ratings"
  ],
  "title": "BoundMessageRatingSet",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
