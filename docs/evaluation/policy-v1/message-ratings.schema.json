{
  "$defs": {
    "MessageRating": {
      "additionalProperties": false,
      "description": "Juízo humano sobre a mensagem da execução principal de um caso.\n\nThe criterion rubric follows section 9.1 of the working document v1.7.\nLegacy development fixtures may omit it; formal ratings require it.\nNo model produces these judgments.",
      "properties": {
        "case_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "condition": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "rater_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rater Id",
          "type": "string"
        },
        "acceptable": {
          "title": "Acceptable",
          "type": "boolean"
        },
        "criteria": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessageRubric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "case_id",
        "condition",
        "rater_id",
        "acceptable"
      ],
      "title": "MessageRating",
      "type": "object"
    },
    "MessageRubric": {
      "additionalProperties": false,
      "description": "Human binary judgments. None means not applicable, not failure.",
      "properties": {
        "supported_and_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supported And Complete"
        },
        "gap_declared": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gap Declared"
        },
        "clarification_material_and_covered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clarification Material And Covered"
        },
        "outdated_notice_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outdated Notice Present"
        },
        "escalation_without_transmission": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Escalation Without Transmission"
        }
      },
      "required": [
        "supported_and_complete",
        "gap_declared",
        "clarification_material_and_covered",
        "outdated_notice_present",
        "escalation_without_transmission"
      ],
      "title": "MessageRubric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "policy_v1_message_ratings_1",
      "title": "Schema Version",
      "type": "string"
    },
    "set_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Set Id",
      "type": "string"
    },
    "ratings": {
      "items": {
        "$ref": "#/$defs/MessageRating"
      },
      "title": "Ratings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "set_id",
    "ratings"
  ],
  "title": "MessageRatingSet",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
