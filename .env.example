APP_NAME=Agentic Institutional Assistant
ENVIRONMENT=development

POSTGRES_DB=institutional_assistant
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://assistant_user:change_me@localhost:5433/institutional_assistant

# Optional: dedicated database for the test suite. If unset, tests use
# DATABASE_URL with "_test" appended to the database name.
TEST_DATABASE_URL=postgresql+psycopg://assistant_user:change_me@localhost:5433/institutional_assistant_test

# Experimental grounded answering. The provider adapter is replaceable
# (ANSWER_GENERATOR_PROVIDER selects it); the approach is not a final
# architectural decision. TOP_K bounds apply to evidence retrieval for
# answering; context/answer limits are measured in characters.
ANSWER_GENERATOR_PROVIDER=openai
ANSWERING_DEFAULT_TOP_K=5
ANSWERING_MAX_TOP_K=10
ANSWERING_MAX_CONTEXT_CHARS=12000
ANSWERING_MAX_ANSWER_CHARS=4000

# OpenAI adapter settings. The application starts without an API key:
# only POST /api/v1/answering/ask fails (503) when generation is needed.
# Keep the real key only in your local .env, never in git or logs.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# Local document storage. A relative path is resolved against the
# repository root; the default lives inside the gitignored storage/
# directory. Files are never stored in PostgreSQL.
DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_FILE_SIZE_MB=20

# Segmentation of extracted text into internal chunks (preparation for a
# future information-retrieval strategy; no retrieval, embeddings or
# search exist yet). Overlap must be smaller than the chunk size.
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150

JWT_SECRET_KEY=change_me_dev_secret_with_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Temporary bootstrap secret: required as the X-Bootstrap-Token header on
# POST /api/v1/institutions, POST /api/v1/auth/register-initial-admin and
# PATCH /api/v1/bootstrap/institutions/{id}/status, since there is no
# platform_admin role yet to authorize those operations. Unset (or
# mismatched) means all three endpoints fail closed. Replace with a long
# random value; do not reuse this placeholder anywhere real.
BOOTSTRAP_TOKEN=change_me_dev_bootstrap_token