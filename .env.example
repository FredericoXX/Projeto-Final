APP_NAME=Agentic Institutional Assistant
ENVIRONMENT=development

POSTGRES_DB=institutional_assistant
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://assistant_user:change_me@localhost:5433/institutional_assistant

# Opcional: base dedicada à suite de testes. Se não for definida, os testes usam
# DATABASE_URL com "_test" acrescentado ao nome da base de dados.
TEST_DATABASE_URL=postgresql+psycopg://assistant_user:change_me@localhost:5433/institutional_assistant_test

# Respostas fundamentadas experimentais. O adaptador do fornecedor é substituível
# (ANSWER_GENERATOR_PROVIDER seleciona-o); a abordagem não é uma decisão
# arquitetural definitiva. Os limites TOP_K aplicam-se à recuperação de evidências;
# os limites de contexto/resposta são medidos em caracteres.
ANSWER_GENERATOR_PROVIDER=openai
ANSWERING_DEFAULT_TOP_K=5
ANSWERING_MAX_TOP_K=10
ANSWERING_MAX_CONTEXT_CHARS=12000
ANSWERING_MAX_ANSWER_CHARS=4000

# Configuração do adaptador OpenAI. A aplicação inicia sem chave de API:
# apenas POST /api/v1/answering/ask falha (503) quando a geração é necessária.
# Mantenha a chave real apenas no .env local, nunca no Git ou em logs.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# Armazenamento local de documentos. Um caminho relativo é resolvido a partir da
# raiz do repositório; o padrão fica dentro da diretoria storage/, ignorada pelo
# Git. Os arquivos nunca são armazenados no PostgreSQL.
DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_FILE_SIZE_MB=20

# Segmentação do texto extraído em chunks internos, usados pela recuperação
# lexical (PostgreSQL Full-Text Search). Continua sem embeddings e sem pesquisa
# semântica. A sobreposição deve ser menor que o tamanho do chunk.
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150

# Retrieval lexical: limiar mínimo de relevância composta (em [0, 1]).
# Aplica-se DEPOIS da elegibilidade (app/retrieval/eligibility.py) e a TODOS os
# candidatos elegíveis, incluindo o melhor e incluindo frases exatas: se todos
# ficarem abaixo, o resultado é vazio. Não substitui o gate de cobertura — é um
# piso residual, e 0.0 desativa-o sem afetar a elegibilidade. O valor tem de ser
# finito e estar em [0, 1]; a aplicação recusa arrancar caso contrário. Os pesos
# do ranking NÃO são configuráveis — são constantes versionadas em
# app/retrieval/reranking.py.
RETRIEVAL_MIN_RELEVANCE_SCORE=0.05

JWT_SECRET_KEY=change_me_dev_secret_with_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Segredo temporário de inicialização: exigido no cabeçalho X-Bootstrap-Token em
# POST /api/v1/institutions, POST /api/v1/auth/register-initial-admin e
# PATCH /api/v1/bootstrap/institutions/{id}/status, pois ainda não existe o papel
# platform_admin para autorizar essas operações. Ausente ou incorreto, faz os três
# endpoints falharem de forma segura. Substitua por um valor aleatório longo;
# não reutilize este placeholder em nenhum ambiente real.
BOOTSTRAP_TOKEN=change_me_dev_bootstrap_token
# OCR local (Tesseract) para PDFs digitalizados. O executável não é
# necessário para arrancar a aplicação nem para documentos com texto
# nativo; sem ele, apenas o processamento que exige OCR falha de forma
# controlada. DOCUMENT_OCR_COMMAND vazio usa o "tesseract" do PATH —
# preencher apenas quando o executável não estiver no PATH.
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_COMMAND=
DOCUMENT_OCR_LANGUAGES=por+eng
DOCUMENT_OCR_DPI=300
DOCUMENT_OCR_TIMEOUT_SECONDS=60
DOCUMENT_OCR_MIN_NATIVE_CHARS=40
DOCUMENT_OCR_MIN_CONFIDENCE=60
DOCUMENT_OCR_MAX_PAGES=200
DOCUMENT_OCR_MAX_PIXELS_PER_PAGE=25000000
