APP_NAME=Agentic Institutional Assistant
ENVIRONMENT=development

POSTGRES_DB=institutional_assistant
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://assistant_user:change_me@localhost:5433/institutional_assistant

# Optional: dedicated database for the test suite. If unset, tests use
# DATABASE_URL with "_test" appended to the database name.
TEST_DATABASE_URL=postgresql+psycopg://assistant_user:change_me@localhost:5433/institutional_assistant_test

OPENAI_API_KEY=

JWT_SECRET_KEY=change_me_dev_secret_with_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Temporary bootstrap secret: required as the X-Bootstrap-Token header on
# POST /api/v1/institutions and POST /api/v1/auth/register-initial-admin,
# since there is no platform_admin role yet to authorize those endpoints.
# Unset (or mismatched) means both endpoints fail closed. Replace with a
# long random value; do not reuse this placeholder anywhere real.
BOOTSTRAP_TOKEN=change_me_dev_bootstrap_token