# Nome da aplicação apresentado na interface (neutro por definição).
VITE_APP_NAME=Institutional Assistant

# Caminho-base das chamadas à API. Mantido relativo para pedidos de mesma origem;
# o servidor de desenvolvimento encaminha-o para DEV_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Destino de /api/* no proxy do Vite durante o desenvolvimento local.
# Nunca faça commit de segredos, tokens ou URLs privadas reais.
DEV_PROXY_TARGET=http://127.0.0.1:8000
