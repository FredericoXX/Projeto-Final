# Application name shown in the UI (institution-neutral by design).
VITE_APP_NAME=Institutional Assistant

# Base path for API calls. Kept relative so the browser makes same-origin
# requests; the dev server proxies it to DEV_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api/* during local development.
# Never commit real secrets, tokens or private URLs.
DEV_PROXY_TARGET=http://127.0.0.1:8000
